# CLI deploys upload the working tree, including git-ignored native builds (2.6GB e2e, ios).
# Allowlist only what the web build needs (Root Directory = apps/web, npm workspaces).
/*
!/apps
!/packages
!/package.json
!/package-lock.json
!/turbo.json
/apps/native/*
!/apps/native/package.json
**/node_modules
**/.next
**/.turbo
**/coverage
**/.env
**/.env.*
!**/.env.example
